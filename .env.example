# Signal / yt-dlp Web
# Copy to .env and replace every CHANGE_ME value before exposing the service.

# Docker Compose / optional Caddy interpolation values.
SITE_ADDRESS=http://localhost
BIND_ADDRESS=127.0.0.1
APP_PORT=8000
DENO_VERSION=2.9.6
APP_VERSION=1.1.0
MEMORY_LIMIT=2g
CPU_LIMIT=2.0

YTDLP_WEB_ENVIRONMENT=production
YTDLP_WEB_HOST=0.0.0.0
YTDLP_WEB_PORT=8000
YTDLP_WEB_LOG_LEVEL=info
YTDLP_WEB_DATA_DIR=/data

# Leave ACCESS_TOKEN empty only for a trusted private network.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
YTDLP_WEB_ACCESS_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
YTDLP_WEB_APP_SECRET=CHANGE_ME_DIFFERENT_RANDOM_SECRET
YTDLP_WEB_COOKIE_SECURE=true
YTDLP_WEB_SESSION_TTL_HOURS=168
YTDLP_WEB_TRUSTED_PROXY=true
# Comma-separated hostnames accepted by the app. Example: dl.example.com,localhost
YTDLP_WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# Network safety. Keep false on every public deployment.
YTDLP_WEB_ALLOW_PRIVATE_URLS=false
YTDLP_WEB_ALLOWED_URL_PORTS=80,443
YTDLP_WEB_MAX_URL_LENGTH=2048
YTDLP_WEB_DNS_TIMEOUT_SECONDS=8

# Queue and worker limits. One Uvicorn process supervises isolated yt-dlp workers.
YTDLP_WEB_MAX_CONCURRENT_OPERATIONS=2
YTDLP_WEB_MAX_QUEUED_OPERATIONS=20
YTDLP_WEB_ANALYSIS_TIMEOUT_SECONDS=120
YTDLP_WEB_DOWNLOAD_TIMEOUT_SECONDS=7200
YTDLP_WEB_CANCEL_GRACE_SECONDS=8

# Media and disk limits.
YTDLP_WEB_MAX_FILESIZE_MB=2048
YTDLP_WEB_MAX_DURATION_SECONDS=14400
YTDLP_WEB_MAX_PLAYLIST_ITEMS=20
YTDLP_WEB_MIN_FREE_DISK_MB=512
YTDLP_WEB_MAX_STORAGE_MB=10240
YTDLP_WEB_ARTIFACT_TTL_HOURS=12
YTDLP_WEB_ANALYSIS_TTL_MINUTES=60
YTDLP_WEB_CLEANUP_INTERVAL_SECONDS=900

# Abuse controls (per process/IP and per principal).
YTDLP_WEB_RATE_LIMIT_REQUESTS=120
YTDLP_WEB_RATE_LIMIT_WINDOW_SECONDS=60
YTDLP_WEB_ANALYSIS_RATE_LIMIT=12
YTDLP_WEB_JOB_RATE_LIMIT=20

# yt-dlp networking and retry settings.
YTDLP_WEB_SOCKET_TIMEOUT_SECONDS=20
YTDLP_WEB_EXTRACTOR_RETRIES=2
YTDLP_WEB_DOWNLOAD_RETRIES=5
YTDLP_WEB_FRAGMENT_RETRIES=5
YTDLP_WEB_CONCURRENT_FRAGMENTS=4
YTDLP_WEB_JS_RUNTIME=deno
YTDLP_WEB_IMPERSONATE=
YTDLP_WEB_PROXY=

# Optional administrator-mounted Netscape cookies file.
# Never let browser users upload cookies to a public instance.
# YTDLP_WEB_COOKIES_FILE=/run/secrets/cookies.txt

# Enable only with the supplied host Nginx config and a matching artifacts alias.
YTDLP_WEB_X_ACCEL_REDIRECT=false
YTDLP_WEB_X_ACCEL_PREFIX=/_protected_downloads

# Reusable signed links for IDM/aria2. Anyone holding a link can download until expiry.
YTDLP_WEB_DIRECT_LINKS_ENABLED=true
YTDLP_WEB_DIRECT_LINK_TTL_MINUTES=120
YTDLP_WEB_DIRECT_LINK_MAX_TTL_MINUTES=1440
# Optional separate 32+ character secret; blank uses APP_SECRET.
# YTDLP_WEB_DIRECT_LINK_SECRET=

# Optional private AWS S3 / R2 / B2 / Wasabi / MinIO artifact storage.
YTDLP_WEB_S3_ENABLED=false
YTDLP_WEB_S3_BUCKET=
YTDLP_WEB_S3_REGION=
YTDLP_WEB_S3_ENDPOINT_URL=
YTDLP_WEB_S3_ALLOW_INSECURE_ENDPOINT=false
YTDLP_WEB_S3_PREFIX=signal-artifacts
YTDLP_WEB_S3_ADDRESSING_STYLE=auto
YTDLP_WEB_S3_KEEP_LOCAL=true
YTDLP_WEB_S3_FAILURE_MODE=fallback
YTDLP_WEB_S3_DELETE_ON_EXPIRY=true
YTDLP_WEB_S3_PRESIGN_TTL_SECONDS=7200
YTDLP_WEB_S3_CONNECT_TIMEOUT_SECONDS=10
YTDLP_WEB_S3_READ_TIMEOUT_SECONDS=120
YTDLP_WEB_S3_RETRY_ATTEMPTS=4
YTDLP_WEB_S3_MULTIPART_THRESHOLD_MB=64
YTDLP_WEB_S3_MULTIPART_CHUNKSIZE_MB=16
YTDLP_WEB_S3_MAX_CONCURRENCY=2
YTDLP_WEB_S3_SERVER_SIDE_ENCRYPTION=
# YTDLP_WEB_S3_KMS_KEY_ID=
YTDLP_WEB_S3_STORAGE_CLASS=
YTDLP_WEB_S3_VERIFY_TLS=true
# YTDLP_WEB_S3_CA_BUNDLE=/run/secrets/s3-ca.pem
YTDLP_WEB_S3_HEALTHCHECK=false

# Credentials are optional when using the AWS default credential/IAM-role chain.
# YTDLP_WEB_S3_ACCESS_KEY_ID=
# YTDLP_WEB_S3_SECRET_ACCESS_KEY=
# YTDLP_WEB_S3_SESSION_TOKEN=
